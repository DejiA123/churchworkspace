{
  "name": "Church Work Space",
  "short_name": "Church Work Space",
  "description": "The church's Video Studio and Social Scheduler: cut a service into shorts, caption it, export it and schedule the posts — from any phone, anywhere.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0a4fc4",
  "categories": ["productivity", "video", "photo"],
  "icons": [
    { "src": "/icons/icon-192.png?v=3", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Open a recording",
      "short_name": "Open",
      "description": "Pick a service recording on the studio machine, or send one from this phone",
      "url": "/?open=1",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
